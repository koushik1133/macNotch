/* SparkV — हिन्दी। macOS अनुमति संकेतों के टेक्स्ट (Info.plist)। */

"NSAppleEventsUsageDescription" = "SparkV Music और Spotify से मौजूदा ट्रैक पढ़ता है और उन्हें चलाने, रोकने और स्किप करने के कमांड भेजता है। जब आप 'Spaces में सहेजें' चुनते हैं, तो यह Safari, Chrome, Arc, Edge या Brave में खुला पेज, या Mail में चुना गया संदेश पढ़ता है। जॉब एजेंट उस जॉब पेज का पता और नाम पढ़ता है जिसे आप fn + Control से कैप्चर करते हैं। फ़ोकस के दौरान यह सामने वाले ब्राउज़र टैब का पता पढ़ता है ताकि आपकी चुनी ब्लॉक की गई साइटें पहचानी जा सकें। मोड के दौरान SparkV आपका चुना संगीत अपनी Safari विंडो में खोलता है (या Music में प्लेलिस्ट चलाता है), मोड ख़त्म होने पर सिर्फ़ वही विंडो बंद करता है, और System Events से लाइट और डार्क दिखावट बदलता है।";
"NSBluetoothAlwaysUsageDescription" = "आपके AirPods और हेडफ़ोन कनेक्ट होने पर SparkV उनकी बैटरी दिखाता है।";
"NSCalendarsFullAccessUsageDescription" = "SparkV नॉच के नीचे आपकी अगली मीटिंग एक-क्लिक 'जुड़ें' बटन के साथ दिखाता है।";
"NSRemindersFullAccessUsageDescription" = "SparkV आपके टिक किए मीटिंग काम Reminders में जोड़ता है। जब तक आप 'जोड़ें' पर क्लिक न करें, कुछ नहीं जुड़ता।";
"NSAudioCaptureUsageDescription" = "एम्बिएंट लाइट चालू होने पर SparkV सुनता है कि आपका Mac क्या चला रहा है, ताकि नॉच आपके संगीत के साथ चमक सके। आवाज़ इसी Mac पर जाँची जाती है और कभी रिकॉर्ड नहीं होती।";
"NSCameraUsageDescription" = "SparkV आपके FaceTime HD कैमरे का इस्तेमाल निजी मिरर प्रीव्यू के लिए, स्क्रीन के बहुत पास बैठने पर चेतावनी देने के लिए (स्क्रीन दूरी, अगर आप चालू करें), और सेट अप करने पर आपका चेहरा पहचानकर Mac अनलॉक करने के लिए करता है। वीडियो डिवाइस पर ही प्रोसेस होता है और कभी आपके Mac से बाहर नहीं जाता।";
"NSDesktopFolderUsageDescription" = "SparkV आपकी स्क्रीन रिकॉर्डिंग डेस्कटॉप पर सहेजता है और जब आप किसी डाउनलोड को वहाँ छाँटते हैं तो उसे वहाँ ले जाता है।";
"NSDocumentsFolderUsageDescription" = "जब आप किसी डाउनलोड को Documents फ़ोल्डर में छाँटते हैं तो SparkV उसे वहाँ ले जाता है।";
"NSDownloadsFolderUsageDescription" = "SparkV नॉच के नीचे डाउनलोड प्रगति दिखाता है और पूरे हुए डाउनलोड छाँटने में मदद करता है। फ़ाइलें तभी हिलती हैं जब आप फ़ोल्डर चुनें या अपने-आप छँटाई का नियम चालू करें।";
"NSFileProviderDomainUsageDescription" = "SparkV iCloud Drive में एक SparkV फ़ोल्डर अप-टू-डेट रखता है ताकि आप अपनी मीटिंग और नोट्स iPhone पर पढ़ सकें।";
"NSMicrophoneUsageDescription" = "जब आप डिक्टेट करते हैं, Clicky से पूछते हैं, मीटिंग रिकॉर्ड करते हैं या स्क्रीन रिकॉर्डिंग में बोलते हैं, तब SparkV सुनता है और आपकी बोली को इसी Mac पर टेक्स्ट में बदलता है।";
"NSSpeechRecognitionUsageDescription" = "SparkV डिक्टेशन, Clicky सवाल और मीटिंग को डिवाइस पर स्पीच रिकग्निशन से ट्रांसक्राइब करता है। ऑडियो कभी आपके Mac से बाहर नहीं जाता।";
